{
  "expo": {
    "name": "MyWork",
    "slug": "mywork",
    "version": "1.0.0",
    "scheme": "mywork",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "bundleIdentifier": "com.kiranlama.mywork",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "To take a photo or video for your story.",
        "NSPhotoLibraryUsageDescription": "To choose a photo or video for your story, or a profile photo.",
        "NSMicrophoneUsageDescription": "To record sound with a story video.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInMedia": true
        }
      }
    },
    "android": {
      "package": "com.mywork.app",
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "To choose a photo or video for your story, or a profile photo.",
          "cameraPermission": "To take a photo or video for your story.",
          "microphonePermission": "To record sound with a story video."
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "To sign you in with Face ID."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92546ab9-dfee-46d1-92e7-ca9f77ec73fa"
      }
    }
  }
}

{
  "expo": {
    "name": "MyWork",
    "slug": "mywork",
    "version": "1.0.0",
    "scheme": "mywork",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "bundleIdentifier": "com.mywork.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "To take a photo or video for your story.",
        "NSPhotoLibraryUsageDescription": "To choose a photo or video for your story, or a profile photo.",
        "NSMicrophoneUsageDescription": "To record sound with a story video.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mywork.app",
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "To choose a photo or video for your story, or a profile photo.",
          "cameraPermission": "To take a photo or video for your story.",
          "microphonePermission": "To record sound with a story video."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

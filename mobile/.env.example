# Where the Django site is. Optional: with no .env the app uses the laptop
# Metro runs on, port 8000 (run `manage.py runserver 0.0.0.0:8000` there).
# Set it to pin an address, and `npx expo start --clear` afterwards. The
# sign-in screen can also change it on the phone without a rebuild.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

__pycache__/
*.pyc
venv/
*.log

# Built by `collectstatic` for production to serve. Everything in it is a copy
# of something already in static/ or in an installed package.
staticfiles/

# Local database: holds password hashes and session keys, so it is not
# published. The PLU data itself is versioned as sample_data/plu_items.csv
# and can be restored through the Import CSV page.
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm

# Profile photos people upload. They belong with the database they are keyed
# to, not with the code — and they are somebody's face, not a project asset.
media/

.DS_Store

# The server's secret key and hostnames. Read by mywork/settings/production.py
# and by manage.py alike, so one file serves the web app and the console.
.env
